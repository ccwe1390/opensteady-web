{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm test)",
      "Bash(npm test:*)",
      "Bash(npm run check)",
      "Bash(npm run benchmark)",
      "Bash(npm run test:browser)",
      "Bash(npm run test:review-links)",
      "Bash(npm ci)",
      "Bash(node --test:*)",
      "Bash(node test/*)",
      "Bash(node tools/mutation_check.cjs)",
      "Bash(node probes/*)",
      "Bash(node benchmark/*)",
      "Bash(python3 tools/package.py)",
      "Bash(python3 tools/contrast.py:*)",
      "Bash(python3 tools/bump_version.py:*)",
      "Bash(python3 benchmark/analyze.py:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Bash(npx playwright install:*)",
      "Read(./traces/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-extension.sh" }
        ]
      }
    ]
  }
}
